# OS noise
.DS_Store
Thumbs.db

# Android build intermediates (final APK is committed; skel/dex/aligned are not)
android/build/

# Web tooling (if ever added)
node_modules/
*.log

# apksigner v4 by-product
*.idsig

# build outputs (rebuilt via android/build.sh / CI)
*.apk
*.keystore

# release signing credentials (NEVER commit; back these up!)
RELEASE_KEY.txt
.release-key-pass

# personal audit log — never commit/push
bugs.md

# pre-signed release APK (public artifact) committed so CI can verify + attach
# it without needing a keystore in CI (repo secrets are not delivered here)
!releases/
!releases/*.apk
